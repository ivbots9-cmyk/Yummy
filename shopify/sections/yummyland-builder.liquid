{%- comment -%}
  Yummyland — the Ruby Signature Gift Box builder
  Drop this section on any page (page template or the home page).
  It renders the five-step builder and adds the finished box to the
  Shopify cart: the gift box variant carrying the order as line item
  properties (customer photos as file uploads) + one line per paid add-on.

  Setup: see shopify/README-SHOPIFY.md
{%- endcomment -%}

{{ 'yummyland-style.css' | asset_url | stylesheet_tag }}

{%- assign box_product = section.settings.box_product -%}
{%- assign addon_collection = section.settings.addons_collection -%}

<div class="yummyland" data-yummyland-builder>
  {%- if section.settings.show_hero -%}
    <section class="hero">
      <div class="wrap hero__in">
        <div>
          <span class="eyebrow">{{ section.settings.eyebrow | default: 'The Ruby Signature Gift Box' }}</span>
          <h1>{{ section.settings.heading | default: 'More than candy.' }}<em>{{ section.settings.heading_accent | default: 'It’s a moment.' }}</em></h1>
          {%- if section.settings.subheading != blank -%}
            <p class="hero__lede">{{ section.settings.subheading }}</p>
          {%- endif -%}
          <div class="hero__cta">
            <a class="btn btn--lg btn--gold" href="#builder">{{ section.settings.cta_label | default: 'Build your gift box' }}</a>
            {%- if section.settings.secondary_url != blank -%}
              <a class="btn btn--lg btn--light" href="{{ section.settings.secondary_url }}">{{ section.settings.secondary_label | default: 'Shop collections' }}</a>
            {%- endif -%}
          </div>
        </div>
        <div class="hero__photo">
          {%- if section.settings.hero_image != blank -%}
            {{ section.settings.hero_image | image_url: width: 1400 | image_tag: loading: 'eager', alt: section.settings.hero_image.alt }}
          {%- else -%}
            <img src="{{ 'yummyland-hero-box.webp' | asset_url }}" width="1448" height="1086" alt="An open Yummyland gift box">
          {%- endif -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  <section class="builder" id="builder">
    <div class="wrap">
      <div class="builder__head">
        <span class="eyebrow">The Ruby Signature Gift Box · 12.75 × 6.5 × 3.75 in</span>
        <h2>Build it <em>your way</em></h2>
        <div class="divider"></div>
      </div>
    </div>
    <div class="bsteps-wrap"><div class="wrap" id="b-steps"></div></div>
    <div class="wrap builder__grid">
      <div class="bprev" id="b-preview" aria-live="polite"></div>
      <div id="b-step"></div>
    </div>
  </section>
</div>

<script>
  window.YL = window.YL || {};
  /* theme assets are flat: this is the folder every yummyland-* file lives in */
  window.YL.ASSET_BASE = {{ 'yummyland-style.css' | asset_url | split: 'yummyland-style.css' | first | json }};
  window.YL_SHOPIFY = {
    routes: {
      cart: {{ routes.cart_url | json }},
      cart_add: {{ routes.cart_add_url | json }},
      builder: {{ section.settings.builder_url | default: '/pages/build-your-box' | json }},
      boxes: {{ section.settings.boxes_url | default: '/collections/gift-boxes' | json }}
    },
    goToCart: {{ section.settings.go_to_cart | json }},
    box: {%- if box_product -%}{ "id": {{ box_product.selected_or_first_available_variant.id }}, "price": {{ box_product.selected_or_first_available_variant.price }} }{%- else -%}null{%- endif -%},
    addons: [
      {%- for p in addon_collection.products -%}
        { "handle": {{ p.handle | json }}, "sku": {{ p.variants.first.sku | json }}, "id": {{ p.variants.first.id }}, "price": {{ p.variants.first.price }} }
        {%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  };
</script>

<script src="{{ 'yummyland-config.js' | asset_url }}" defer></script>
<script src="{{ 'yummyland-art.js' | asset_url }}" defer></script>
<script src="{{ 'yummyland-data.js' | asset_url }}" defer></script>
<script src="{{ 'yummyland-store.js' | asset_url }}" defer></script>
<script src="{{ 'yummyland-analytics.js' | asset_url }}" defer></script>
<script src="{{ 'yummyland-site.js' | asset_url }}" defer></script>
<script src="{{ 'yummyland-pages.js' | asset_url }}" defer></script>
<script src="{{ 'yummyland-shopify-cart.js' | asset_url }}" defer></script>
<script src="{{ 'yummyland-builder.js' | asset_url }}" defer></script>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    if (window.YL && YL.initBuilder) YL.initBuilder();
  });
</script>

{% schema %}
{
  "name": "Yummyland gift box builder",
  "tag": "section",
  "class": "yummyland-section",
  "settings": [
    {
      "type": "product",
      "id": "box_product",
      "label": "Gift box product",
      "info": "The 'Ruby Signature Gift Box' product (SKU YL-RUBY-SIGNATURE) from products.csv."
    },
    {
      "type": "collection",
      "id": "addons_collection",
      "label": "Add-ons collection",
      "info": "Collection holding the YL-ADD-* finishing touches and YL-POUCH-* refill pouches."
    },
    { "type": "header", "content": "Hero" },
    { "type": "checkbox", "id": "show_hero", "label": "Show hero above the builder", "default": true },
    { "type": "image_picker", "id": "hero_image", "label": "Hero photo" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Ruby Signature Gift Box" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "More than candy." },
    { "type": "text", "id": "heading_accent", "label": "Heading, script line", "default": "It’s a moment." },
    {
      "type": "textarea", "id": "subheading", "label": "Subheading",
      "default": "Six sealed cups of Albanese gummies and chocolate, a lid printed for the occasion and, if you like, two of your own photos inside."
    },
    { "type": "text", "id": "cta_label", "label": "Primary button", "default": "Build your gift box" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button", "default": "Shop collections" },
    { "type": "url", "id": "secondary_url", "label": "Secondary button link" },
    { "type": "header", "content": "Builder" },
    { "type": "checkbox", "id": "go_to_cart", "label": "Go to cart after adding a box", "default": true },
    { "type": "url", "id": "builder_url", "label": "Builder page URL", "info": "Used by 'Personalise' links. Default /pages/build-your-box" },
    { "type": "url", "id": "boxes_url", "label": "Collections page URL" }
  ],
  "presets": [{ "name": "Yummyland gift box builder" }]
}
{% endschema %}
