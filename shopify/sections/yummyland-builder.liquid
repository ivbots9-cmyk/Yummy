{%- comment -%}
  Yummyland — Build Your Own Box
  Drop this section on any page (page template or the home page).
  It renders the full box builder and adds the finished box to the
  Shopify cart as a size variant + one line item per paid add-on.

  Setup: see shopify/README-SHOPIFY.md
{%- endcomment -%}

{{ 'yummyland-style.css' | asset_url | stylesheet_tag }}

{%- assign box_product = section.settings.box_product -%}
{%- assign addon_collection = section.settings.addons_collection -%}

<div class="yummyland" data-yummyland-builder>
  {%- if section.settings.show_hero -%}
    <section class="hero">
      <div class="wrap hero__in">
        <div>
          {%- if section.settings.eyebrow != blank -%}
            <span class="badge">{{ section.settings.eyebrow }}</span>
          {%- endif -%}
          <h1 style="margin-top:14px">
            {{ section.settings.heading | default: 'Build your' }}
            <span>{{ section.settings.heading_accent | default: 'own box.' }}</span>
          </h1>
          {%- if section.settings.subheading != blank -%}
            <p class="lede">{{ section.settings.subheading }}</p>
          {%- endif -%}
          <div class="hero__cta">
            <a class="btn btn--lg" href="#builder">{{ section.settings.cta_label | default: 'Start building' }}</a>
            {%- if section.settings.secondary_url != blank -%}
              <a class="btn btn--lg btn--ghost" href="{{ section.settings.secondary_url }}">
                {{ section.settings.secondary_label | default: 'Shop ready-made boxes' }}</a>
            {%- endif -%}
          </div>
          <div class="hero__usps">
            <div class="usp" data-usp="heart|Fresh &amp; delicious|Packed fresh to order"></div>
            <div class="usp" data-usp="candy|Made your way|You choose everything"></div>
            <div class="usp" data-usp="truck|Shipped fast|Quick &amp; reliable delivery"></div>
          </div>
        </div>
        <div class="hero__art">
          <div data-hero-box></div>
          <div class="float-badge">Made<br>to share <span aria-hidden="true">&hearts;</span></div>
        </div>
      </div>
    </section>
  {%- endif -%}

  <section class="builder" id="builder">
    <div class="wrap">
      <div class="steps" id="steps"></div>
      <div class="builder__grid">
        <div>
          <div class="card" id="step-size"></div>
          <div class="card" id="step-candy"></div>
          <div class="card" id="step-vibe"></div>
          <div class="card" id="step-extras"></div>
          <div class="card" id="step-review"></div>
        </div>
        <aside class="preview">
          <div class="panel" id="panel"></div>
          {%- if section.settings.show_inspiration -%}
            <div class="card" id="inspo" style="margin-top:20px"></div>
          {%- endif -%}
        </aside>
      </div>
    </div>
  </section>
</div>

<script>
  window.YL_SHOPIFY = {
    routes: {
      cart: {{ routes.cart_url | json }},
      cart_add: {{ routes.cart_add_url | json }},
      builder: {{ section.settings.builder_url | default: '/pages/build-your-box' | json }},
      boxes: {{ section.settings.boxes_url | default: '/collections/candy-boxes' | json }}
    },
    goToCart: {{ section.settings.go_to_cart | default: false | json }},
    variants: [
      {%- for v in box_product.variants -%}
        { "title": {{ v.title | json }}, "id": {{ v.id }}, "price": {{ v.price }}, "available": {{ v.available | json }} }
        {%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ],
    addons: [
      {%- for p in addon_collection.products -%}
        { "handle": {{ p.handle | json }}, "sku": {{ p.variants.first.sku | json }}, "id": {{ p.variants.first.id }}, "price": {{ p.variants.first.price }} }
        {%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  };
</script>

<script src="{{ 'yummyland-config.js' | asset_url }}" defer></script>
<script src="{{ 'yummyland-art.js' | asset_url }}" defer></script>
<script src="{{ 'yummyland-data.js' | asset_url }}" defer></script>
<script src="{{ 'yummyland-store.js' | asset_url }}" defer></script>
<script src="{{ 'yummyland-site.js' | asset_url }}" defer></script>
<script src="{{ 'yummyland-pages.js' | asset_url }}" defer></script>
<script src="{{ 'yummyland-shopify-cart.js' | asset_url }}" defer></script>
<script src="{{ 'yummyland-builder.js' | asset_url }}" defer></script>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    if (!window.YL || !YL.initBuilder) return;
    YL.initBuilder();

    var hero = document.querySelector('[data-hero-box]');
    if (hero) hero.innerHTML = YL.boxArt({ color: 'pink', recipe: YL.mixedRecipe(), fill: 1, seed: 'hero' });

    Array.prototype.forEach.call(document.querySelectorAll('[data-usp]'), function (el) {
      var p = el.getAttribute('data-usp').split('|');
      el.innerHTML = YL.icon(p[0]) + '<span><b>' + p[1] + '</b><span>' + p[2] + '</span></span>';
    });
  });
</script>

{% schema %}
{
  "name": "Yummyland box builder",
  "tag": "section",
  "class": "yummyland-section",
  "settings": [
    {
      "type": "product",
      "id": "box_product",
      "label": "Box product",
      "info": "The 'Build Your Own Candy Box' product. Its variants are the box sizes (Small / Medium / Large / Party)."
    },
    {
      "type": "collection",
      "id": "addons_collection",
      "label": "Add-ons collection",
      "info": "Collection holding the yl-extra-* and yl-premium-* products created from products.csv."
    },
    { "type": "header", "content": "Hero" },
    { "type": "checkbox", "id": "show_hero", "label": "Show hero above the builder", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Packed fresh · Shipped nationwide" },
    { "type": "text", "id": "heading", "label": "Heading line 1", "default": "Build your" },
    { "type": "text", "id": "heading_accent", "label": "Heading line 2 (pink)", "default": "own box." },
    {
      "type": "textarea", "id": "subheading", "label": "Subheading",
      "default": "Choose your size, pick your favourite candy, add fun extras — and we'll pack it fresh just for you."
    },
    { "type": "text", "id": "cta_label", "label": "Primary button", "default": "Start building" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button", "default": "Shop ready-made boxes" },
    { "type": "url", "id": "secondary_url", "label": "Secondary button link" },
    { "type": "header", "content": "Builder" },
    { "type": "checkbox", "id": "show_inspiration", "label": "Show auto-build presets", "default": true },
    { "type": "checkbox", "id": "go_to_cart", "label": "Go to cart after adding a box", "default": false },
    { "type": "url", "id": "builder_url", "label": "Builder page URL", "info": "Used by 'Customize' links. Default /pages/build-your-box" },
    { "type": "url", "id": "boxes_url", "label": "Ready-made boxes URL" }
  ],
  "presets": [{ "name": "Yummyland box builder" }]
}
{% endschema %}
