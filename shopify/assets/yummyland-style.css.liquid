.yummyland .chips { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 14px; }
.yummyland .chip {
  display: inline-flex; align-items: center; gap: 6px;
  background: var(--pink-50); border: 1px solid var(--line); border-radius: 999px;
  padding: 4px 6px 4px 10px; font-size: 12px; font-weight: 700;
}
.yummyland .chip .x { border: 0; background: transparent; color: var(--ink-40); display: grid; place-items: center; padding: 2px; border-radius: 50%; }
.yummyland .chip .x:hover { color: var(--pink); background: #ffd9e9; }
.yummyland .chip--slot { border-style: dashed; color: var(--ink-40); font-weight: 600; }
.yummyland .lines { border-top: 1px solid var(--line); margin-top: 14px; padding-top: 12px; }
.yummyland .line { display: flex; justify-content: space-between; gap: 10px; font-size: 13.5px; padding: 4px 0; color: var(--ink-60); }
.yummyland .line b { color: var(--ink); font-weight: 800; }
.yummyland .line--total {
  border-top: 1px solid var(--line); margin-top: 8px; padding-top: 12px;
  font-family: var(--display); font-size: 17px; color: var(--ink); font-weight: 800; text-transform: uppercase;
}
.yummyland .line--total b { color: var(--pink); font-size: 26px; }
.yummyland .line--free b { color: var(--mint); }
.yummyland .panel__cta { display: grid; gap: 9px; margin-top: 16px; }
.yummyland .guarantee {
  display: flex; gap: 10px; align-items: center; margin-top: 14px; padding: 12px 14px;
  background: var(--pink-50); border-radius: var(--radius); font-size: 12.5px; color: var(--ink-60);
}
.yummyland .guarantee svg { width: 26px; height: 26px; color: var(--pink); flex: none; }
.yummyland .guarantee b { display: block; color: var(--ink); font-size: 13px; }
.yummyland .inspo { margin-top: 20px; }
.yummyland .inspo__row {
  display: flex; align-items: center; gap: 12px; padding: 9px 6px; border-bottom: 1px solid var(--line);
}
.yummyland .inspo__row:last-child { border-bottom: 0; }
.yummyland .inspo__row svg { width: 34px; height: 34px; flex: none; border-radius: 9px; }
.yummyland .inspo__row b { font-size: 13px; }
.yummyland .inspo__row small { display: block; font-size: 11.5px; color: var(--ink-40); }
.yummyland .inspo__row .btn { margin-left: auto; }
.yummyland .grid-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(216px, 1fr)); gap: 18px; }
.yummyland .pcard {
  background: #fff; border: 1px solid var(--line); border-radius: var(--radius-l); overflow: hidden;
  transition: transform .18s, box-shadow .18s; display: flex; flex-direction: column;
}
.yummyland .pcard:hover { transform: translateY(-5px); box-shadow: var(--shadow); }
.yummyland .pcard__art { position: relative; background: linear-gradient(180deg, #fff6fa, #ffe8f2); padding: 6px 6px 0; }
.yummyland .pcard__tag {
  position: absolute; top: 12px; left: 12px; z-index: 2;
  background: var(--pink); color: #fff; border-radius: 999px; padding: 5px 12px;
  font-size: 10px; font-weight: 900; letter-spacing: .1em; text-transform: uppercase;
}
.yummyland .pcard__body { padding: 14px 16px 18px; display: flex; flex-direction: column; flex: 1; }
.yummyland .pcard__body h3 { font-size: 16px; text-transform: uppercase; }
.yummyland .pcard__body p { font-size: 13px; color: var(--ink-60); margin: 6px 0 12px; flex: 1; }
.yummyland .pcard__price { font-family: var(--display); font-weight: 800; color: var(--pink); font-size: 17px; margin-bottom: 12px; }
.yummyland .pcard__price small { color: var(--ink-40); font-family: var(--font); font-size: 11px; font-weight: 700; }
.yummyland .how { display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; }
@media (max-width: 900px) {.yummyland .how { grid-template-columns: repeat(2, 1fr); }}
.yummyland .how__item { text-align: center; padding: 10px; }
.yummyland .how__item svg { width: 46px; height: 46px; margin: 0 auto 12px; color: var(--pink); }
.yummyland .how__item b { display: block; font-size: 12.5px; font-weight: 900; letter-spacing: .06em; text-transform: uppercase; color: var(--pink); }
.yummyland .how__item p { font-size: 13px; color: var(--ink-60); margin: 6px 0 0; }
.yummyland .occasions { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 14px; }
.yummyland .occasion {
  display: flex; align-items: center; gap: 12px; padding: 16px 18px;
  border: 1px solid var(--line); border-radius: var(--radius-l); background: #fff; transition: .18s;
}
.yummyland .occasion:hover { transform: translateY(-4px); box-shadow: var(--shadow-s); border-color: #ffb2d5; }
.yummyland .occasion svg { width: 40px; height: 40px; flex: none; color: var(--pink); }
.yummyland .occasion b { display: block; font-size: 13.5px; font-weight: 900; letter-spacing: .04em; text-transform: uppercase; }
.yummyland .occasion small { color: var(--ink-40); font-size: 12.5px; }
.yummyland .banner {
  background: linear-gradient(120deg, var(--pink) 0%, #ff5ea8 55%, #ff8ec4 100%);
  color: #fff; border-radius: var(--radius-xl); padding: 40px; overflow: hidden; position: relative;
  display: grid; grid-template-columns: 1fr 1fr; gap: 30px; align-items: center;
}
@media (max-width: 860px) {.yummyland .banner { grid-template-columns: 1fr; padding: 28px; }}
.yummyland .banner h2 { font-size: clamp(26px, 3.6vw, 40px); text-transform: uppercase; }
.yummyland .banner p { max-width: 420px; opacity: .95; }
.yummyland .banner .btn { background: #fff; color: var(--pink); box-shadow: none; }
.yummyland .banner .btn:hover { background: #ffe3f0; }
.yummyland .banner__list { display: grid; gap: 12px; }
.yummyland .banner__list div { display: flex; align-items: center; gap: 12px; font-weight: 800; font-size: 13px; letter-spacing: .06em; text-transform: uppercase; }
.yummyland .banner__list svg { width: 30px; height: 30px; flex: none; }
.yummyland .reviews { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 16px; }
.yummyland .review { background: #fff; border: 1px solid var(--line); border-radius: var(--radius-l); padding: 22px; }
.yummyland .review .stars { color: var(--pink); font-size: 15px; letter-spacing: 2px; }
.yummyland .review p { font-size: 14.5px; margin: 10px 0 14px; }
.yummyland .review b { font-size: 13px; color: var(--ink-60); }
.yummyland .faq { max-width: 780px; margin: 0 auto; }
.yummyland .faq details {
  border: 1px solid var(--line); border-radius: var(--radius); background: #fff; padding: 16px 20px; margin-bottom: 10px;
}
.yummyland .faq details[open] { border-color: #ffb2d5; }
.yummyland .faq summary { font-weight: 900; cursor: pointer; list-style: none; display: flex; justify-content: space-between; gap: 12px; }
.yummyland .faq summary::-webkit-details-marker { display: none; }
.yummyland .faq summary::after { content: "+"; color: var(--pink); font-size: 22px; line-height: 1; }
.yummyland .faq details[open] summary::after { content: "–"; }
.yummyland .faq p { color: var(--ink-60); margin: 10px 0 0; font-size: 14.5px; }
.yummyland .footer { background: var(--pink); color: #fff; padding: 52px 0 26px; margin-top: 10px; }
.yummyland .footer__grid { display: grid; grid-template-columns: 1.6fr repeat(3, 1fr) 1.5fr; gap: 30px; }
@media (max-width: 980px) {.yummyland .footer__grid { grid-template-columns: 1fr 1fr; }}
.yummyland .footer h4 { font-size: 12px; letter-spacing: .16em; text-transform: uppercase; margin-bottom: 14px; opacity: .9; font-family: var(--font); font-weight: 900; }
.yummyland .footer ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
.yummyland .footer a { font-size: 13.5px; opacity: .92; }
.yummyland .footer a:hover { text-decoration: underline; }
.yummyland .footer__brand .logo__txt { color: #fff; font-size: 30px; }
.yummyland .footer__brand .logo__sub { display: none; }
.yummyland .footer .logo__mark { width: 40px; height: 40px; }
.yummyland .socials svg { width: 18px; height: 18px; }
.yummyland .footer__brand p { font-size: 13.5px; opacity: .92; max-width: 260px; margin: 12px 0 16px; }
.yummyland .socials { display: flex; gap: 10px; }
.yummyland .socials a { width: 36px; height: 36px; border-radius: 50%; background: rgba(255, 255, 255, .18); display: grid; place-items: center; transition: .15s; }
.yummyland .socials a:hover { background: #fff; color: var(--pink); }
.yummyland .subscribe { display: flex; gap: 8px; margin-top: 14px; }
.yummyland .subscribe input {
  flex: 1; min-width: 0; border: 0; border-radius: 999px; padding: 12px 18px; background: rgba(255, 255, 255, .2);
  color: #fff; outline: 0;
}
.yummyland .subscribe input::placeholder { color: rgba(255, 255, 255, .75); }
.yummyland .subscribe input:focus { background: rgba(255, 255, 255, .3); }
.yummyland .subscribe button { border: 0; border-radius: 999px; background: #fff; color: var(--pink); padding: 12px 22px; font-weight: 900; font-size: 13px; }
.yummyland .footer__bottom {
  display: flex; flex-wrap: wrap; gap: 16px; justify-content: space-between;
  border-top: 1px solid rgba(255, 255, 255, .25); margin-top: 34px; padding-top: 18px; font-size: 12.5px; opacity: .9;
}
.yummyland .footer__bottom nav { display: flex; gap: 18px; flex-wrap: wrap; }
.yummyland .cart-grid { display: grid; grid-template-columns: minmax(0, 1fr) 360px; gap: 24px; align-items: start; }
@media (max-width: 980px) {.yummyland .cart-grid { grid-template-columns: 1fr; }}
.yummyland .cart-item {
  display: grid; grid-template-columns: 118px 1fr auto; gap: 16px; align-items: start;
  border: 1px solid var(--line); border-radius: var(--radius-l); padding: 16px; background: #fff; margin-bottom: 14px;
}
@media (max-width: 620px) {.yummyland .cart-item { grid-template-columns: 84px 1fr; }}
.yummyland .cart-item__art { border-radius: var(--radius); overflow: hidden; background: var(--pink-50); }
.yummyland .cart-item h3 { font-size: 17px; text-transform: uppercase; }
.yummyland .cart-item .meta { font-size: 13px; color: var(--ink-60); margin-top: 4px; }
.yummyland .cart-item .tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
.yummyland .tag { background: var(--pink-50); border-radius: 999px; padding: 3px 10px; font-size: 11.5px; font-weight: 700; color: var(--ink-60); }
.yummyland .cart-item__side { text-align: right; display: grid; gap: 10px; justify-items: end; }
.yummyland .cart-item__price { font-family: var(--display); font-size: 20px; font-weight: 800; color: var(--pink); }
.yummyland .link-btn { border: 0; background: transparent; color: var(--ink-40); font-size: 12.5px; font-weight: 700; text-decoration: underline; padding: 0; }
.yummyland .link-btn:hover { color: var(--pink); }
.yummyland .empty { text-align: center; padding: 60px 20px; border: 2px dashed var(--line); border-radius: var(--radius-l); }
.yummyland .empty svg { width: 120px; margin: 0 auto 16px; }
.yummyland .empty h3 { font-size: 22px; text-transform: uppercase; }
.yummyland .empty p { color: var(--ink-60); margin: 8px 0 20px; }
.yummyland .promo { display: flex; gap: 8px; margin: 14px 0; }
.yummyland .promo input { flex: 1; min-width: 0; border: 1.5px solid var(--line); border-radius: 999px; padding: 11px 16px; outline: 0; }
.yummyland .promo input:focus { border-color: var(--pink); }
.yummyland .page-head { background: linear-gradient(180deg, #fff6fa, #ffeef6); padding: 46px 0 40px; text-align: center; }
.yummyland .page-head h1 { font-size: clamp(32px, 5vw, 54px); text-transform: uppercase; }
.yummyland .page-head p { color: var(--ink-60); max-width: 560px; margin: 12px auto 0; }
.toast {
  position: fixed; left: 50%; bottom: 26px; transform: translate(-50%, 130%);
  background: var(--ink); color: #fff; border-radius: 999px; padding: 13px 24px;
  font-weight: 800; font-size: 14px; z-index: 200; box-shadow: var(--shadow-l);
  display: flex; align-items: center; gap: 10px; transition: transform .32s cubic-bezier(.2, .9, .3, 1.2);
  max-width: calc(100% - 40px);
}
.toast.is-on { transform: translate(-50%, 0); }
.toast svg { width: 20px; height: 20px; color: #6ee7c4; flex: none; }
.yummyland .pop { animation: pop .35s ease; }
@keyframes pop { 0% { transform: scale(.86); } 60% { transform: scale(1.06); } 100% { transform: scale(1); } }
.yummyland .tick-in { animation: tickIn .3s ease; }
@keyframes tickIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
@media (prefers-reduced-motion: reduce) {.yummyland * { animation: none !important; transition: none !important; }
.yummyland { scroll-behavior: auto; }}