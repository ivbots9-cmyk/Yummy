.toast {
  position: fixed; left: 50%; bottom: 24px; z-index: 100; display: flex; align-items: center; gap: 10px;
  max-width: calc(100% - 32px); padding: 13px 20px; border-radius: 999px; background: var(--ruby-ink); color: var(--cream);
