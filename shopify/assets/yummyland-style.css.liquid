.yummyland .proof__stars { color: var(--pink); letter-spacing: 2px; font-size: 15px; }
.yummyland .proof b { color: var(--ink); }
.yummyland .announce {
  background: linear-gradient(90deg, var(--pink) 0%, #ff5ea8 100%);
  color: #fff; font-size: 12.5px; font-weight: 800;
}
.yummyland .announce__in {
  position: relative; display: grid; place-items: center;
  min-height: 40px; padding: 8px 0; text-align: center;
}
.yummyland .announce__item {
  grid-area: 1 / 1;
  display: flex; align-items: center; justify-content: center; gap: 9px; flex-wrap: wrap;
  opacity: 0; transform: translateY(8px); pointer-events: none;
  transition: opacity .45s ease, transform .45s ease;
}
.yummyland .announce__item.is-on { opacity: 1; transform: none; pointer-events: auto; }
.yummyland .announce__item.is-out { opacity: 0; transform: translateY(-8px); }
.yummyland .announce__item svg { width: 17px; height: 17px; flex: none; }
.yummyland .announce b { font-weight: 900; }
.yummyland .announce a { text-decoration: underline; white-space: nowrap; }
.yummyland .trust {
  display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px;
  border: 1px solid var(--line); border-radius: var(--radius-l);
  background: #fff; padding: 18px 20px;
}
.yummyland .trust__item { display: flex; align-items: center; gap: 11px; }
.yummyland .trust__item svg { width: 30px; height: 30px; color: var(--pink); flex: none; }
.yummyland .trust__item b {
  display: block; font-size: 12.5px; font-weight: 900;
  letter-spacing: .05em; text-transform: uppercase;
}
.yummyland .trust__item span { font-size: 12.5px; color: var(--ink-40); }
@media (max-width: 860px) {.yummyland .trust { grid-template-columns: 1fr 1fr; }}
@media (max-width: 560px) {.yummyland .trust { gap: 16px 10px; padding: 15px 14px; border-radius: var(--radius); }
.yummyland .trust__item { gap: 8px; }
.yummyland .trust__item svg { width: 23px; height: 23px; }
.yummyland .trust__item b { font-size: 11px; letter-spacing: .03em; }
.yummyland .trust__item span { font-size: 11.5px; line-height: 1.35; }}
.yummyland .offer {
  position: fixed; inset: 0; z-index: 190;
  display: grid; place-items: center; padding: 20px;
  background: rgba(20, 16, 26, .5);
  opacity: 0; transition: opacity .25s ease;
}
.yummyland .offer.is-on { opacity: 1; }
.yummyland .offer__box {
  position: relative; width: min(420px, 100%); background: #fff;
  border-radius: var(--radius-xl); padding: 0 26px 28px; text-align: center;
  box-shadow: var(--shadow-l); overflow: hidden;
  transform: translateY(14px); transition: transform .25s ease;
}
.yummyland .offer.is-on .offer__box { transform: none; }
.yummyland .offer__art { margin: 0 -26px 6px; background: linear-gradient(180deg, #fff6fa, #ffe8f2); padding: 10px 20px 0; }
.yummyland .offer__box h3 { font-size: 24px; text-transform: uppercase; }
.yummyland .offer__box p { color: var(--ink-60); font-size: 14px; margin: 10px 0 16px; }
.yummyland .offer__form { display: flex; gap: 8px; }
.yummyland .offer__form input {
  flex: 1; min-width: 0; border: 1.5px solid var(--line);
  border-radius: 999px; padding: 12px 16px; outline: 0;
}
.yummyland .offer__form input:focus { border-color: var(--pink); }
.yummyland .ship-goal { margin: 14px 0 0; }
.yummyland .ship-goal__bar { height: 8px; border-radius: 999px; background: #ffd9e9; overflow: hidden; margin-top: 8px; }
.yummyland .ship-goal__bar i { display: block; height: 100%; background: linear-gradient(90deg, var(--pink), #ff7ab5); transition: width .3s ease; }
.yummyland .ship-goal p { font-size: 12.5px; color: var(--ink-60); margin: 0; }
.yummyland .ship-goal p b { color: var(--pink); }
.yummyland .ship-goal.is-done p b { color: var(--mint); }
.yummyland .peek-fab {
  position: fixed; right: 22px; bottom: 22px; z-index: 70;
  width: 74px; height: 74px; padding: 0; border: 3px solid var(--pink); border-radius: 50%;
  background: linear-gradient(180deg, #fff6fa, #ffe0ee);
  box-shadow: 0 0 0 4px rgba(255, 30, 135, .16), 0 14px 32px rgba(255, 30, 135, .38);
  overflow: hidden;
  transition: transform .18s ease, box-shadow .18s ease, opacity .2s ease;
  
  opacity: 0; pointer-events: none; transform: scale(.8);
}
.yummyland .peek-fab.is-live { opacity: 1; pointer-events: auto; transform: none; }
.yummyland .peek-fab.is-live:hover { transform: scale(1.06); }
.yummyland .peek-fab.is-open { transform: scale(.94); }
.yummyland .peek-fab__art { position: absolute; inset: 0; display: grid; place-items: center; overflow: hidden; }
.yummyland .peek-fab__art svg { width: 132%; max-width: none; transform: translateY(6%); }
.yummyland .peek-fab__badge {
  position: absolute; top: -2px; right: -2px;
  min-width: 26px; height: 26px; padding: 0 7px;
  display: grid; place-items: center;
  background: var(--pink); color: #fff; border: 2px solid #fff; border-radius: 999px;
  font-size: 12px; font-weight: 900;
}
.yummyland .peek-fab__badge.is-empty { background: var(--ink-40); }
.yummyland .peek {
  position: fixed; right: 22px; bottom: 108px; z-index: 69;
  width: min(370px, calc(100vw - 44px));
  
  max-height: calc(100vh - var(--header-h) - 170px);
  overflow: auto; border-radius: var(--radius-l);
  opacity: 0; transform: translateY(14px) scale(.98); pointer-events: none;
  transition: opacity .2s ease, transform .22s cubic-bezier(.2, .9, .3, 1.1);
}
.yummyland .peek.is-open { opacity: 1; transform: none; pointer-events: auto; }
.yummyland .peek .panel { box-shadow: var(--shadow-l); }
.yummyland .peek__close { display: none; }
@media (max-width: 720px) {.yummyland .peek-fab { right: 14px; bottom: 88px; width: 62px; height: 62px; }
.yummyland .peek {
    right: 0; left: 0; bottom: 0; width: 100%;
    max-height: 82vh; border-radius: var(--radius-xl) var(--radius-xl) 0 0;
    transform: translateY(100%);
  }
.yummyland .peek .panel { border-radius: var(--radius-xl) var(--radius-xl) 0 0; }
.yummyland.peek-open .peek-fab { opacity: 0; pointer-events: none; }
.yummyland .peek-fab { transition: transform .18s ease, opacity .2s ease; }
.yummyland .peek__close {
    display: grid; place-items: center;
    position: sticky; top: 10px; left: 100%; z-index: 3;
    width: 38px; height: 38px; margin: 10px 12px -38px 0;
    border: 0; border-radius: 50%;
    background: rgba(255, 255, 255, .94); color: var(--ink); box-shadow: var(--shadow-s);
  }
.yummyland .peek__close svg { width: 18px; height: 18px; }
.yummyland.peek-open { overflow: hidden; }
.yummyland.peek-open .mbar { transform: translateY(120%); }
.yummyland .mbar { transition: transform .25s ease; }}
@media (max-width: 400px) {.yummyland .header__in { gap: 6px; }
.yummyland .logo { gap: 7px; }
.yummyland .logo__mark { width: 30px; height: 30px; }
.yummyland .logo__txt { font-size: 19px; }
.yummyland .header__tools { gap: 0; }
.yummyland .icon-btn { width: 34px; height: 34px; }
.yummyland .icon-btn svg { width: 20px; height: 20px; }
.yummyland .cart-count { min-width: 17px; height: 17px; font-size: 10px; }}